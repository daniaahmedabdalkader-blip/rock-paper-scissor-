using namespace std;
string comp(){
    string move[]={"rock","paper","scissor"};
    random_device rd;
    uniform_int_distribution<int> dist(0,2);
    string computer= move[dist(rd)];
    cout <<computer;
    return computer;
}
string play(){
    string player;
    cout<<"Put rock, paper or scissors:\n";
    cin>> player;
    if(player=="rock" || player=="paper" || player=="scissors"){
        cout<<"\n"<<"____________"<<"\n"<<player<<"\n";
    }else{
        cout<<"invaled, try again";
    }
